<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>YT Downloader X Pro</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
<link rel="stylesheet" href="~/css/style.css">
</head>
<body>
<div class="app-shell">
  <nav class="sidebar">
    <div class="sidebar-brand">
      <i class="fa-solid fa-bolt-lightning"></i>
      <span>YT Downloader <b>X Pro</b></span>
    </div>
    <ul class="sidebar-nav">
      <li class="@(ViewBag.ActivePage == "dashboard" ? "active" : "")"><a href="/"><i class="fa-solid fa-gauge-high"></i> Dashboard</a></li>
      <li class="@(ViewBag.ActivePage == "downloads" ? "active" : "")"><a href="/Home/Downloads"><i class="fa-solid fa-download"></i> Downloads &amp; Queue</a></li>
      <li class="@(ViewBag.ActivePage == "history" ? "active" : "")"><a href="/Home/History"><i class="fa-solid fa-clock-rotate-left"></i> History</a></li>
      <li class="@(ViewBag.ActivePage == "settings" ? "active" : "")"><a href="/Home/Settings"><i class="fa-solid fa-sliders"></i> Settings</a></li>
      <li class="@(ViewBag.ActivePage == "about" ? "active" : "")"><a href="/Home/About"><i class="fa-solid fa-circle-info"></i> About</a></li>
    </ul>
  </nav>
  <div class="main-area">
    <div class="topbar">
      <button class="btn-topbar-toggle d-lg-none" id="sidebarToggle"><i class="fa-solid fa-bars"></i></button>
      <div class="topbar-title">@ViewBag.PageTitle</div>
      <div class="topbar-status"><span class="pulse-dot"></span> Live</div>
    </div>
    <div class="content-area">
      @RenderBody()
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script src="~/js/app.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
