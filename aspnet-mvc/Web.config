<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="104857600" />
    <sessionState timeout="1440" />
  </system.web>
  <appSettings>
    <add key="SecretKey" value="change-this-secret-in-production" />
    <add key="DefaultDownloadFolder" value="downloads" />
    <add key="DefaultTempFolder" value="temp" />
    <add key="LogDir" value="logs" />
    <add key="DefaultMaxConcurrent" value="3" />
    <add key="DefaultConcurrentFragments" value="8" />
    <add key="DefaultMaxRetries" value="3" />
  </appSettings>
</configuration>
