@{ ViewBag.PageTitle = "Settings"; }
<div class="glass-panel">
  <form id="settingsForm">
    <div class="row g-3">
      <div class="col-12 col-md-6"><label class="form-label">Download Folder</label><input type="text" class="form-control" name="download_folder"></div>
      <div class="col-12 col-md-6"><label class="form-label">Temp Folder</label><input type="text" class="form-control" name="temp_folder"></div>
      <div class="col-6 col-md-3"><label class="form-label">Max Concurrent</label><input type="number" min="1" max="10" class="form-control" name="max_concurrent"></div>
      <div class="col-6 col-md-3"><label class="form-label">Concurrent Fragments</label><input type="number" min="1" max="32" class="form-control" name="concurrent_fragments"></div>
      <div class="col-6 col-md-3"><label class="form-label">Max Retries</label><input type="number" min="0" max="10" class="form-control" name="max_retries"></div>
      <div class="col-6 col-md-3"><label class="form-label">Speed Limit (KB/s)</label><input type="number" min="0" class="form-control" name="speed_limit_kbps"></div>
      <div class="col-12 col-md-6"><label class="form-label">Proxy</label><input type="text" class="form-control" name="proxy"></div>
      <div class="col-12 col-md-6"><label class="form-label">FFmpeg Path</label><input type="text" class="form-control" name="ffmpeg_path"></div>
      <div class="col-12">
        <div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" name="embed_metadata"><label class="form-check-label">Embed metadata</label></div>
        <div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" name="embed_thumbnail"><label class="form-check-label">Embed thumbnail</label></div>
        <div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" name="embed_subtitles"><label class="form-check-label">Embed subtitles</label></div>
        <div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" name="sponsorblock"><label class="form-check-label">Remove sponsor segments</label></div>
      </div>
    </div>
    <button type="submit" class="btn btn-neon mt-3"><i class="fa-solid fa-floppy-disk"></i> Save Settings</button>
  </form>
</div>
@section Scripts { <script src="~/js/settings.js"></script> }
