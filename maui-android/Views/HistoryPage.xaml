<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="YTDownloaderXPro.Views.HistoryPage"
             Title="History"
             BackgroundColor="#0A0E17">
    <VerticalStackLayout Padding="16" Spacing="12">
        <Entry x:Name="searchEntry" Placeholder="Search history..." TextChanged="OnSearchChanged" TextColor="#E8ECF5" PlaceholderColor="#8B95AB" BackgroundColor="#141A29" />
        <CollectionView x:Name="historyList" VerticalOptions="FillAndExpand">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="#141A29" CornerRadius="12" Padding="12" Margin="0,4" BorderColor="Transparent">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}" FontSize="14" TextColor="#E8ECF5" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Uploader}" FontSize="12" TextColor="#8B95AB" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding QualityLabel}" FontSize="11" TextColor="#3EA6FF" />
                                <Label Grid.Column="1" Text="{Binding Status}" FontSize="11" TextColor="#35E0A1" />
                            </Grid>
                            <Button Text="🗑 Delete" Clicked="OnDeleteClicked" CommandParameter="{Binding Id}" BackgroundColor="#1A1F2E" TextColor="#FF5C7A" CornerRadius="8" FontSize="11" Padding="8,4" HorizontalOptions="End" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
